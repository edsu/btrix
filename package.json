{
  "name": "@edsu/btrix",
  "version": "0.1.5",
  "description": "A chatbot for Browsertrix Crawler",
  "license": "MIT AND AGPL-3.0-or-later",
  "author": "Ed Summers",
  "type": "module",
  "pi": {
    "extensions": [
      "."
    ],
    "skills": [
      "skills"
    ]
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@earendil-works/pi-tui": "0.87.1",
    "typebox": "^1.3.27"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "scripts": {
    "test": "vitest run",
    "check": "tsc --noEmit",
    "btrix": "pi -e .",
    "prepublishOnly": "npm run check && npm test"
  },
  "bin": {
    "btrix": "./bin/btrix.js"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "files": [
    "bin",
    "assets",
    "src",
    "skills",
    "scripts",
    "vendor",
    "index.ts",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "web-archiving",
    "wacz",
    "browsertrix",
    "warc",
    "webrecorder",
    "replayweb",
    "pi",
    "agent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/edsu/btrix.git"
  },
  "homepage": "https://edsu.github.io/btrix/",
  "publishConfig": {
    "access": "public"
  }
}
