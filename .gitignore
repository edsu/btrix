node_modules/

# Crawl working-directory contents, in case you run a crawl from inside the
# repo. No trailing slashes: these are often symlinked elsewhere, and a
# trailing slash would only match a real directory.
collections
config
profiles
tmp
.btrix
*.wacz

# A btrix store created by running btrix from inside its own repo. Rooted, so
# it cannot match the repository directory itself.
/btrix/

.DS_Store
