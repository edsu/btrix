{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    // Two modules are plain JS because bin/btrix.js must load them before pi
    // starts, and Node will not strip types under node_modules. Checked here
    // so they are not a hole in the type coverage.
    "allowJs": true,
    "checkJs": true,
    "types": ["node"]
  },
  "include": ["index.ts", "src/**/*.ts", "src/**/*.js", "test/**/*.ts"]
}
